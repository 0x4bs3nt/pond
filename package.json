    },
    "dependencies": {
        "@opentui/core": "^0.6.8",
        "@opentui/react": "^0.6.8",
        "react": "^19.3.1"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/react": "^19.3.0",
        "prettier": "3.9.10",
        "typescript": "^7.0.2"
    }
}
